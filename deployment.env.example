# Runtime injection via ECS / SSM SecureString. Do not store actual secrets here.
# Use staging only for isolated test deployments; production is the default.
TICKET_DEPLOY_ENV=production
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Required in production (at least 32 characters) for hashing guest OTP codes.
GUEST_OTP_PEPPER=
# Proxy chain trust: `cloudflare` (Cloudflare -> ALB) or a positive integer hop count (e.g. `1`).
TRUST_PROXY=cloudflare
# Optional signing secret overrides (at least 32 characters when set; otherwise fall back to BETTER_AUTH_SECRET).
# QUEUE_TOKEN_SECRET=
# OFFLINE_ASSIGNMENT_SECRET=
# UPLOAD_FINALIZE_SECRET=

# Amazon SES (ADR-0003, TASK-045, AC-126/127/128)
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Default is ap-southeast-1 if omitted
SES_REGION=ap-southeast-1
# Example format: TICKET <tickets@your-verified-domain.com>
EMAIL_FROM=
# Optional Amazon SES Inbound Mailbox (SNS webhook / S3 raw MIME fetch / Reply behavior)
# SES_INBOUND_WEBHOOK_SECRET=
# SES_INBOUND_SNS_TOPIC_ARN=
# SES_INBOUND_S3_BUCKET=
# SES_INBOUND_ALLOWED_RECIPIENTS=support@phatysd.me,organizer@phatysd.me,organizer-support@phatysd.me
# SES_REPLY_USE_MAILBOX_FROM=false

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional alternative to R2_ACCOUNT_ID:
R2_ENDPOINT=
