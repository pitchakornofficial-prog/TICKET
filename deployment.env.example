# Runtime injection via ECS / SSM SecureString. Do not store actual secrets here.
# Use staging only for isolated test deployments; production is the default.
TICKET_DEPLOY_ENV=production
DATABASE_URL=
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=

# Amazon SES (ADR-0003, TASK-045, AC-126/127/128)
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Default is ap-southeast-1 if omitted
SES_REGION=ap-southeast-1
# Example format: TICKET <tickets@your-verified-domain.com>
EMAIL_FROM=

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Optional alternative to R2_ACCOUNT_ID:
R2_ENDPOINT=
