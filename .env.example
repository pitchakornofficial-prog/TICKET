# Local development only. Copy to .env.local; do not put deployment secrets here.
# These PostgreSQL credentials are the loopback-only values from compose.yaml.
DATABASE_URL=postgresql://ticket:ticket_local@127.0.0.1:55432/ticket_dev

# Optional integer override. Code fallback is 25; production task configuration
# must set 15 to match the per-task pool budget in ADR-0002.
DATABASE_POOL_MAX=

# Better Auth: required for authenticated app use in local and production.
# Local URL must be a loopback HTTP origin; production requires an HTTPS origin.
BETTER_AUTH_URL=http://127.0.0.1:3000
# Run `npm run auth:local` to generate this locally (at least 32 characters).
BETTER_AUTH_SECRET=

# Security / signing secrets. Optional overrides let each feature use a dedicated key.
# If blank, these fall back to BETTER_AUTH_SECRET (with development-only fallbacks locally).
# Any configured override must contain at least 32 characters; production fails closed if shorter.
OFFLINE_ASSIGNMENT_SECRET=
UPLOAD_FINALIZE_SECRET=

# Production must set a dedicated pepper of at least 32 characters.
# Local fallback: BETTER_AUTH_SECRET, then a development-only built-in value.
GUEST_OTP_PEPPER=
# Optional; if unset, queue hashes and cookie signing use BETTER_AUTH_SECRET.
# A configured value must be at least 32 characters; otherwise production fails closed.
# If both secrets are absent, non-production uses a development-only built-in key.
QUEUE_TOKEN_SECRET=
# Optional legacy fallback for order links; BETTER_AUTH_SECRET takes precedence.
# Production already requires BETTER_AUTH_SECRET, so normally leave blank.
# If both are absent, local uses a development-only built-in key; production fails closed.
TICKET_ORDER_LINK_SECRET=

# Client IP trust: blank disables forwarded-header trust (local default).
# Set a positive proxy hop count, e.g. 1, or `cloudflare` when Cloudflare
# overwrites CF-Connecting-IP. Production must match the actual proxy chain.
TRUST_PROXY=
# Legacy scanner cookie compatibility is allowed only outside production by default.
# Set `false` to disable it in non-production too.
ALLOW_LEGACY_SCANNER_SCOPE_COOKIE=

# Stripe PromptPay (ADR-0003). Blank keys use the local contract double.
# Production requires matching keys: sk_/rk_live_ + pk_live_; staging requires
# sk_/rk_test_ + pk_test_. STRIPE_WEBHOOK_SECRET must be the endpoint whsec_ value.
# A webhook request returns HTTP 500 when STRIPE_WEBHOOK_SECRET is missing.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional override; exact `true` forces live mode. Live keys also activate live mode.
STRIPE_LIVE_MODE=false

# Amazon SES (ADR-0003). With no credentials, local email is captured locally.
# Production currently requires one complete credential pair and EMAIL_FROM.
# SES_* takes precedence; AWS_* is an accepted alias (each credential field
# falls back independently). Region fallback: SES_REGION -> AWS_REGION -> ap-southeast-1.
# Current code signs SES requests with static credentials; it does not use an ECS task-role credential chain.
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
# Production requires a verified public sender address; local falls back to each message's from.
EMAIL_FROM=

# Cloudflare R2 (ADR-0003). Blank configuration uses the local storage double.
# Production requires access key, secret key, bucket and either account ID or HTTPS endpoint.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# If blank, endpoint is derived from R2_ACCOUNT_ID.
R2_ENDPOINT=
# Optional public CDN base URL; private objects do not use this value.
R2_PUBLIC_BASE_URL=

# Local-only simulation and preview controls. Both server and NEXT_PUBLIC flag
# must be true to show the payment test UI; API access is also server-gated.
# NEXT_PUBLIC values are compiled into browser JavaScript and must never contain secrets.
# Production config rejects ENABLE_PAY_TEST=true.
ENABLE_PAY_TEST=false
NEXT_PUBLIC_ENABLE_PAY_TEST=false
# Captured email preview is local-only and disabled unless explicitly enabled.
ENABLE_DEV_MAIL_PREVIEW=false
NEXT_PUBLIC_ENABLE_DEV_MAIL_PREVIEW=false

# Optional local/testing scripts. Test organizer password, when supplied, must
# be 15-128 characters; otherwise the script generates a random password.
TEST_ORGANIZER_EMAIL=organizer@ticket.local
TEST_ORGANIZER_NAME=ผู้จัดงานทดสอบ
TEST_ORGANIZER_PASSWORD=
# Freshy seed password: optional locally (random password generated), required
# when seeding the organizer account in production; 15-128 characters.
SEED_UBU_ORGANIZER_PASSWORD=
# Ticket sale simulation defaults when unset.
TARGET_TICKETS=4500
CONCURRENCY=20
# Integration tests use TEST_DATABASE_URL from .env.test.local instead.
# Copy .env.test.example to .env.test.local; do not set it in the runtime .env.local.
# TEST_DATABASE_URL=

# Production config checker only. Blank/omitted means production validation;
# use exactly `staging` for a staging validation.
TICKET_DEPLOY_ENV=
# One-time owner bootstrap only; normally injected from SSM for the operations task.
# Do not keep this password in .env.local.
BOOTSTRAP_OWNER_PASSWORD=

# Isolated capacity tooling only (scripts/capacity/README.md). These values are
# supplied to that runner, never the normal app environment. boot.mjs requires
# CAPACITY_ISOLATED=true, a fresh capacity_20261112_<8 hex> database name and a
# staging Neon URL; it creates a database that is retained for review.
# CAPACITY_ISOLATED=
# CAPACITY_DATABASE=
# STAGING_DATABASE_URL=
# CAPACITY_TARGET=  # private IPv4 HTTP URL only
# CAPACITY_PROVIDER_MODE is set internally to test by boot.mjs.
# boot.mjs also sets HOSTNAME=0.0.0.0 and PORT=3000 internally.

# Tooling defaults/managed variables.
# NEXT_DIST_DIR defaults to .next; leave blank unless a tool needs a separate build directory.
NEXT_DIST_DIR=
# Playwright config defaults to .cache/ms-playwright; npm scripts set this path too.
PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright
# NODE_ENV is set by Next.js; VITEST is set by Vitest. Do not set them manually here.

# Deprecated provider names: runtime no longer reads RESEND_API_KEY or any OMISE_* variable.
# Old provider labels remain in historical ADR text and test-only mocks; RESEND_API_KEY is deny-listed only.
