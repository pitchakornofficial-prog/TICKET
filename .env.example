# Local development only. Copy to .env.local; never use these credentials remotely.
DATABASE_URL=postgresql://ticket:ticket_local@127.0.0.1:55432/ticket_dev

BETTER_AUTH_URL=http://127.0.0.1:3000
# npm run auth:local creates a random secret in .env.local; never use a checked-in secret.
BETTER_AUTH_SECRET=

# Cloudflare R2 (ADR-0003); production ต้องตั้งครบ ไม่งั้น storage จะ error
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
