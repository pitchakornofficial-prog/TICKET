{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "TICKET production operations preparation",
  "Parameters": {
    "WebImage": {
      "Type": "String",
      "Description": "Web runner image pinned by digest (ECR repo@sha256:...), built from Dockerfile target runner for linux/arm64",
      "AllowedPattern": "^[0-9]+\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$",
      "ConstraintDescription": "Must be an ECR image pinned by sha256 digest"
    },
    "OperationsImage": {
      "Type": "String",
      "Description": "Operations image pinned by digest (ECR repo@sha256:...), built from Dockerfile target operations for linux/arm64",
      "AllowedPattern": "^[0-9]+\\.dkr\\.ecr\\.[a-z0-9-]+\\.amazonaws\\.com/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$",
      "ConstraintDescription": "Must be an ECR image pinned by sha256 digest"
    }
  },
  "Resources": {
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "ticket-production"
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/ticket-production",
        "RetentionInDays": 14
      }
    },
    "TaskSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "TICKET production task outbound",
        "VpcId": "vpc-04b2a1a3c10a0306b"
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ],
        "Policies": [
          {
            "PolicyName": "ReadProductionDatabaseOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameters"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/DATABASE_URL_DIRECT"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/BOOTSTRAP_OWNER_PASSWORD"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "OperationsTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "ticket-production-operations",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "512",
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "operations",
            "Image": {
              "Ref": "OperationsImage"
            },
            "Essential": true,
            "Command": [
              "node",
              "scripts/db-check.ts"
            ],
            "Secrets": [
              {
                "Name": "DATABASE_URL",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/DATABASE_URL_DIRECT"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "ops"
              }
            }
          }
        ]
      }
    },
    "WebExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ],
        "Policies": [
          {
            "PolicyName": "ReadProductionParameters",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ssm:GetParameters"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Ingress": {
      "Type": "AWS::EC2::SecurityGroupIngress",
      "Properties": {
        "GroupId": {
          "Ref": "TaskSecurity"
        },
        "IpProtocol": "tcp",
        "FromPort": 3000,
        "ToPort": 3000,
        "SourceSecurityGroupId": "sg-01826a56935021d21"
      }
    },
    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": "ticket-production-web",
        "VpcId": "vpc-04b2a1a3c10a0306b",
        "Port": 3000,
        "Protocol": "HTTP",
        "TargetType": "ip",
        "HealthCheckPath": "/api/health",
        "Matcher": {
          "HttpCode": "200"
        }
      }
    },
    "WebTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "ticket-production-web",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "512",
        "Memory": "1024",
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "WebExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "web",
            "Image": {
              "Ref": "WebImage"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 3000,
                "Protocol": "tcp"
              }
            ],
            "Environment": [
              {
                "Name": "TICKET_DEPLOY_ENV",
                "Value": "production"
              },
              {
                "Name": "BETTER_AUTH_URL",
                "Value": "https://ticket.phatysd.me"
              },
              {
                "Name": "EMAIL_FROM",
                "Value": "TICKET <tickets@phatysd.me>"
              },
              {
                "Name": "SES_REGION",
                "Value": "ap-southeast-1"
              },
              {
                "Name": "DATABASE_POOL_MAX",
                "Value": "15"
              }
            ],
            "Secrets": [
              {
                "Name": "DATABASE_URL",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/DATABASE_URL"
                }
              },
              {
                "Name": "BETTER_AUTH_SECRET",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/BETTER_AUTH_SECRET"
                }
              },
              {
                "Name": "SES_ACCESS_KEY_ID",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/SES_ACCESS_KEY_ID"
                }
              },
              {
                "Name": "SES_SECRET_ACCESS_KEY",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/SES_SECRET_ACCESS_KEY"
                }
              },
              {
                "Name": "STRIPE_SECRET_KEY",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/STRIPE_SECRET_KEY"
                }
              },
              {
                "Name": "STRIPE_PUBLISHABLE_KEY",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/STRIPE_PUBLISHABLE_KEY"
                }
              },
              {
                "Name": "STRIPE_WEBHOOK_SECRET",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/STRIPE_WEBHOOK_SECRET"
                }
              },
              {
                "Name": "R2_ACCESS_KEY_ID",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/R2_ACCESS_KEY_ID"
                }
              },
              {
                "Name": "R2_SECRET_ACCESS_KEY",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/R2_SECRET_ACCESS_KEY"
                }
              },
              {
                "Name": "R2_BUCKET",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/R2_BUCKET"
                }
              },
              {
                "Name": "R2_ACCOUNT_ID",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/R2_ACCOUNT_ID"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "web"
              }
            }
          }
        ]
      }
    },
    "WebService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": [
        "ProductionRule"
      ],
      "Properties": {
        "ServiceName": "ticket-production-web",
        "Cluster": {
          "Ref": "Cluster"
        },
        "TaskDefinition": {
          "Ref": "WebTask"
        },
        "LaunchType": "FARGATE",
        "DesiredCount": 1,
        "DeploymentConfiguration": {
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          },
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        },
        "HealthCheckGracePeriodSeconds": 90,
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              "subnet-031011f6ddef9bf0d",
              "subnet-0fe3fde21c408f0d9"
            ],
            "SecurityGroups": [
              {
                "Ref": "TaskSecurity"
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "web",
            "ContainerPort": 3000,
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "OwnerTask": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "ticket-production-owner-bootstrap",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "NetworkMode": "awsvpc",
        "Cpu": "256",
        "Memory": "512",
        "RuntimePlatform": {
          "CpuArchitecture": "ARM64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "operations",
            "Image": {
              "Ref": "OperationsImage"
            },
            "Essential": true,
            "Command": [
              "node",
              "-e",
              "const {spawnSync}=require('node:child_process'); const input=JSON.stringify({name:'Yodsavee',email:'yodsavee.su.68@ubu.ac.th',password:process.env.BOOTSTRAP_OWNER_PASSWORD}); const env={...process.env}; delete env.BOOTSTRAP_OWNER_PASSWORD; const r=spawnSync(process.execPath,['scripts/bootstrap-owner.ts'],{input,env,stdio:['pipe','inherit','inherit']}); process.exit(r.status ?? 1);"
            ],
            "Secrets": [
              {
                "Name": "DATABASE_URL",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/DATABASE_URL_DIRECT"
                }
              },
              {
                "Name": "BOOTSTRAP_OWNER_PASSWORD",
                "ValueFrom": {
                  "Fn::Sub": "arn:${AWS::Partition}:ssm:${AWS::Region}:${AWS::AccountId}:parameter/ticket/production/BOOTSTRAP_OWNER_PASSWORD"
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Ref": "Logs"
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "ops"
              }
            }
          }
        ]
      }
    },
    "ProductionRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": "arn:aws:elasticloadbalancing:ap-southeast-1:901708383730:listener/app/ticket-workload-alb/b5befd83bb1b6303/0faa60d4e1a2b3dd",
        "Priority": 50,
        "Conditions": [
          {
            "Field": "host-header",
            "HostHeaderConfig": {
              "Values": [
                "ticket.phatysd.me"
              ]
            }
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "TargetGroup"
            }
          }
        ]
      }
    },
    "AlertTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": "ticket-production-alerts"
      }
    },
    "WebScalableTarget": {
      "Type": "AWS::ApplicationAutoScaling::ScalableTarget",
      "DependsOn": [
        "WebService"
      ],
      "Properties": {
        "ServiceNamespace": "ecs",
        "ScalableDimension": "ecs:service:DesiredCount",
        "MinCapacity": 1,
        "MaxCapacity": 4,
        "ResourceId": {
          "Fn::Sub": "service/${Cluster}/${WebService.Name}"
        },
        "RoleARN": {
          "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/aws-service-role/ecs.application-autoscaling.amazonaws.com/AWSServiceRoleForApplicationAutoScaling_ECSService"
        }
      }
    },
    "WebCpuScalingPolicy": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": "ticket-production-cpu-scaling",
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "WebScalableTarget"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 60.0,
          "ScaleOutCooldown": 60,
          "ScaleInCooldown": 300,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ECSServiceAverageCPUUtilization"
          }
        }
      }
    },
    "WebAlbRequestScalingPolicy": {
      "Type": "AWS::ApplicationAutoScaling::ScalingPolicy",
      "Properties": {
        "PolicyName": "ticket-production-alb-request-scaling",
        "PolicyType": "TargetTrackingScaling",
        "ScalingTargetId": {
          "Ref": "WebScalableTarget"
        },
        "TargetTrackingScalingPolicyConfiguration": {
          "TargetValue": 100.0,
          "ScaleOutCooldown": 60,
          "ScaleInCooldown": 300,
          "PredefinedMetricSpecification": {
            "PredefinedMetricType": "ALBRequestCountPerTarget",
            "ResourceLabel": {
              "Fn::Sub": "app/ticket-workload-alb/b5befd83bb1b6303/${TargetGroup.TargetGroupFullName}"
            }
          }
        }
      }
    },
    "AlbTarget5xxAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "ticket-production-alb-5xx",
        "AlarmDescription": "Triggers when production web target returns 5xx errors",
        "Namespace": "AWS/ApplicationELB",
        "MetricName": "HTTPCode_Target_5XX_Count",
        "Dimensions": [
          {
            "Name": "LoadBalancer",
            "Value": "app/ticket-workload-alb/b5befd83bb1b6303"
          },
          {
            "Name": "TargetGroup",
            "Value": {
              "Fn::GetAtt": [
                "TargetGroup",
                "TargetGroupFullName"
              ]
            }
          }
        ],
        "Statistic": "Sum",
        "Period": 300,
        "EvaluationPeriods": 1,
        "Threshold": 5,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ]
      }
    },
    "SesBounceRateAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "ticket-production-ses-bounce-rate",
        "AlarmDescription": "Triggers when Amazon SES reputation bounce rate reaches 5%",
        "Namespace": "AWS/SES",
        "MetricName": "Reputation.BounceRate",
        "Statistic": "Maximum",
        "Period": 900,
        "EvaluationPeriods": 1,
        "Threshold": 0.05,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ]
      }
    },
    "SesComplaintRateAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": "ticket-production-ses-complaint-rate",
        "AlarmDescription": "Triggers when Amazon SES reputation complaint rate reaches 0.1%",
        "Namespace": "AWS/SES",
        "MetricName": "Reputation.ComplaintRate",
        "Statistic": "Maximum",
        "Period": 900,
        "EvaluationPeriods": 1,
        "Threshold": 0.001,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlertTopic"
          }
        ]
      }
    }
  },
  "Outputs": {
    "SecurityGroup": {
      "Value": {
        "Ref": "TaskSecurity"
      }
    },
    "TaskDefinition": {
      "Value": {
        "Ref": "OperationsTask"
      }
    },
    "Cluster": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "AlertTopicArn": {
      "Value": {
        "Ref": "AlertTopic"
      }
    }
  }
}
